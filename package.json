    "mcp": "node src/mcp.mjs",
    "live-test": "node --test tests/live.test.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@xyflow/react": "12.12.0",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-force-graph-3d": "^1.29.1",
    "zod": "^4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eye9444/Medusae.git"
  }
