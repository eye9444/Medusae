{
  "name": "project-medusae",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local repository assistant with terminal chat, source-linked architecture maps, and a 3D knowledge graph.",
  "scripts": {
    "start": "node src/cli.mjs",
    "preview": "node src/cli.mjs --preview",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build --webpack",
